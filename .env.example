# Bot トークン（必須）
DISCORD_TOKEN=

# 単一ギルドの ID。指定するとスラッシュコマンドが即時反映される
GUILD_ID=

# 実行ファイルのパス（既定は PATH 上のコマンド）
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# YouTube の bot 判定対策（Netscape 形式の cookie ファイル）
# 例: YTDLP_COOKIES_FILE=/Users/you/cookies.txt
YTDLP_COOKIES_FILE=

# 再生操作を許可する DJ ロール ID（未設定でも「接続中 VC に在席 or 管理者」で許可される）
DJ_ROLE_ID=

# 既定音量（0-200, %）
DEFAULT_VOLUME=80

# キューの上限件数
MAX_QUEUE=50

# 添付ファイルのダウンロード上限（MB）。超過した時点で中断する
MAX_ATTACHMENT_MB=200

# 人間が全員 VC からいなくなったときに自動退出するまでの猶予ミリ秒。
# 0 で即座に退出、負値（-1 など）で無効。戻ってきた場合は取り消されます。
LEAVE_WHEN_EMPTY_MS=30000

# 無音状態が続いたときに自動退出するまでのミリ秒。0 で無効（監視を継続）
IDLE_TIMEOUT_MS=0

# ダウンロードした一時ファイルの置き場所（未指定なら OS の一時領域）
TEMP_DIR=

# デバッグログ（1 で有効）
DEBUG=0
