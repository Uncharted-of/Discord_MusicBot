{
  "name": "discord-vc-music-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Uncharted-of",
  "type": "module",
  "description": "Discord VC music bot: plays mp3 attachments and YouTube links posted in the voice channel's text chat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
